{
  "manifest_version": 3,
  "name": "Auto Apply — Google Forms Autofill",
  "version": "1.0.0",
  "description": "Fills Google Forms from your Auto Apply profile — works on sign-in / org-restricted forms because it runs in your logged-in browser.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://docs.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Auto Apply Autofill" },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["rules.js", "content-form.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
