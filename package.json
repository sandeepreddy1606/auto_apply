{
  "name": "auto-apply",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev --port 8787",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "auth:recover": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/auth-recover.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs --test \"tests/*.test.ts\"",
    "migrate:pg": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/migrate-sqlite-to-pg.ts",
    "test:integration": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs --test --test-concurrency=1 \"tests/integration/*.test.ts\"",
    "worker": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs worker/index.ts"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@fontsource-variable/bricolage-grotesque": "5.2.8",
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource/ibm-plex-sans": "5.2.6",
    "@fontsource/mukta": "5.3.0",
    "@fontsource/rozha-one": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "codemirror": "^6.0.2",
    "next": "^16.3.0",
    "node-html-parser": "^7.0.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "playwright": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.9.3"
  }
}
